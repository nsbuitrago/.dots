export EDITOR=hx
bindkey -v

eval "$(starship init zsh)"
eval "$(zoxide init zsh)"

# aliases
alias ls="eza --icons"
alias hf='hx "$(fzf)"'
alias ll="ls -l"
alias lg="lazygit"
alias gs="git status"

cf() {
  local dir
  dir=$(fd . -type d 2> /dev/null | fzf) && cd "$dir"
}

# go
export GOPATH=$HOME/go
export PATH=$PATH:$GOROOT/bin:$GOPATH/bin
export PATH=$PATH:$HOME/.cargo/bin
